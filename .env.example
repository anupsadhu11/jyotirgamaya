PORT=3000
PYTHON_API_URL=http://127.0.0.1:8000
# Both PORT (Express) and PYTHON_PORT (the Python service, default 8000)
# are read from this same file - they must stay different. Only set
# PYTHON_PORT/PYTHON_HOST here if you need to override the Python side's
# defaults; plain PORT only ever applies to Express.
# PYTHON_PORT=8000
# PYTHON_HOST=127.0.0.1

# Required for the "Ask Guruji" chat feature. Get a key at
# https://console.anthropic.com/settings/keys - without it, /api/guruji/chat
# returns a clear "not configured" error instead of failing silently.
ANTHROPIC_API_KEY=
# Optional: override the model Guruji uses (defaults to claude-sonnet-5).
# GURUJI_MODEL=claude-sonnet-5
